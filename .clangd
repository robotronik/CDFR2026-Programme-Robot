# Shared clangd configuration, used by every editor and by
# scripts/clangd-docker.sh.
#
# The compilation database is generated by CMake inside the build container
# (see cmake/compiler_config.cmake) and is refreshed on each ./build.sh run.
# Querying the container's g++ gives clangd the system and standard library
# include paths that match the build.
CompileFlags:
  CompilationDatabase: build/x86_64
  Compiler: /usr/bin/c++
