# Shared clangd configuration, used by every editor and by
# scripts/clangd-docker.sh.
#
# The compilation database is generated by that script, inside the x86_64
# build image, into .cache/clangd-db. It is deliberately not build/x86_64:
# that tree belongs to ./build.sh, is wiped by `./build.sh clean`, and can be
# reconfigured on the host by the CMake Tools extension (which would record
# host compiler and include paths).
#
# Querying the container's g++ gives clangd the system and standard library
# include paths that match the build.
CompileFlags:
  CompilationDatabase: .cache/clangd-db
  Compiler: /usr/bin/c++

# IncludeCleaner logs an error for every header it cannot map in the database
# ("Failed to get an entry for resolved path"), which floods the log; unused
# include diagnostics are not worth that noise.
Diagnostics:
  UnusedIncludes: None
