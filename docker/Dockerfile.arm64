# Build image for the aarch64 (Raspberry Pi) target, cross-compiled on amd64 with
# the aarch64-linux-gnu toolchain; target libraries come from arm64 multiarch
# packages. The base is Debian 13 (trixie), matching Raspberry Pi OS Trixie: GCC
# 14 / glibc 2.41, OpenCV 4.10, and the Pi libcamera fork (libcamera.so.0.7).

FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

# Add the Raspberry Pi archive: the pinned libcamera below needs its
# libtensorflow-lite. It is marked trusted (not signed-by): its InRelease is
# SHA1-signed, which trixie's `sqv` refuses. (Debian's own trixie suites already
# cover arm64.) Low priority, so Debian wins everywhere it has the package.
RUN dpkg --add-architecture arm64 \
    && printf '%s\n' \
        'deb [trusted=yes] http://archive.raspberrypi.com/debian/ trixie main' \
        > /etc/apt/sources.list.d/raspberrypi.list \
    && printf '%s\n' \
        'Package: *' \
        'Pin: origin "archive.raspberrypi.com"' \
        'Pin-Priority: 100' \
        > /etc/apt/preferences.d/raspberrypi.pref

# The exact libcamera revision installed on the robot (see docs/raspberry-pi.md).
# The archive only indexes the newest revisions, so the .debs come from its pool.
ARG RPI_POOL=https://archive.raspberrypi.com/debian/pool/main
ADD --checksum=sha256:c7dfaadcf9cd3b03fc41f0d457c88736d2638fa79d1cca11fc3637777cdae3c9 ${RPI_POOL}/libc/libcamera/libcamera0.7_0.7.2+rpt20260817-1_arm64.deb /tmp/debs/
ADD --checksum=sha256:b799340d3f753563f583f705af26411b45d8426b6f13d0b734b4da0872bb3b62 ${RPI_POOL}/libc/libcamera/libcamera-dev_0.7.2+rpt20260817-1_arm64.deb /tmp/debs/
ADD --checksum=sha256:0de238bc7f0a23bf4ab90604d232c88e92c0b5fa724272d555fdc570ca4d30f4 ${RPI_POOL}/libc/libcamera/libcamera-ipa_0.7.2+rpt20260817-1_arm64.deb /tmp/debs/
ADD --checksum=sha256:8fa7ecd55730771249c243132a562f43477c513858de2e3b79eef04cbdefc8e1 ${RPI_POOL}/libp/libpisp/libpisp1_1.7.0-1_arm64.deb /tmp/debs/
ADD --checksum=sha256:d2a97e4e5c9cd182fb1878aefcacb2dee665c012024a046e976876102d0f76ab ${RPI_POOL}/libp/libpisp/libpisp-common_1.7.0-1_all.deb /tmp/debs/

# The headers keep their 2026-08 package date: touch them so ninja recompiles a
# build/arm64 tree built against another libcamera revision.
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        ninja-build \
        git \
        ca-certificates \
        pkg-config \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        libsqlite3-dev:arm64 \
        libopencv-dev:arm64 \
        libopencv-contrib-dev:arm64 \
        /tmp/debs/*.deb \
        rsync \
        openssh-client \
    && rm -rf /var/lib/apt/lists/* /tmp/debs \
    && find /usr/include/libcamera -name '*.h' -exec touch {} +

# External robot repositories: drive/protocol headers used at compile time.
# Baked into the image so the build is self-contained.
ARG DRIVE_CONTROL_REF=main
ARG ACTIONNEUR_REF=master
# BuildKit resolves the branch head on each build, so a new commit invalidates the layer; .git is not kept.
ADD https://github.com/robotronik/CDFR2026-Program-DriveControl.git#${DRIVE_CONTROL_REF} /opt/cdfr/CDFR2026-Program-DriveControl
ADD https://github.com/robotronik/cdfr2024-programme-Actionneur.git#${ACTIONNEUR_REF} /opt/cdfr/cdfr2024-programme-Actionneur

# Debian has no non-root user, so create `ubuntu` (uid/gid 1000) like the old
# Ubuntu base: workspace files stay user-owned, and build.sh's --user and the
# $HOME/.ssh bind mount have a home.
RUN groupadd -g 1000 ubuntu \
    && useradd -m -u 1000 -g 1000 -s /bin/bash ubuntu
ENV HOME=/home/ubuntu

WORKDIR /workspace
