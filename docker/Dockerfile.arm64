# Build image for the aarch64 (Raspberry Pi) target, cross-compiled on amd64 with
# the aarch64-linux-gnu toolchain; target libraries come from arm64 multiarch
# packages. The base is Debian 13 (trixie), matching Raspberry Pi OS Trixie: GCC
# 14 / glibc 2.41, OpenCV 4.10, and the Pi libcamera fork (libcamera.so.0.7).

FROM debian:trixie

ENV DEBIAN_FRONTEND=noninteractive

# Add the Raspberry Pi archive for the libcamera fork that drives the Pi 5 camera.
# It is marked trusted (not signed-by): its InRelease is SHA1-signed, which
# trixie's `sqv` refuses. (Debian's own trixie suites already cover arm64.)
RUN dpkg --add-architecture arm64 \
    && printf '%s\n' \
        'deb [trusted=yes] http://archive.raspberrypi.com/debian/ trixie main' \
        > /etc/apt/sources.list.d/raspberrypi.list

# Keep the Pi archive at low priority so Debian wins everywhere, and prefer it
# only for the libcamera stack. Pins must name the foreign architecture
# explicitly (pkg:arm64) or they do not match; libpisp1 is Multi-Arch: same and
# also in Debian, so both architectures are pinned to the Pi version so apt can
# pair arm64 libcamera0.7 with a matching libpisp1.
RUN printf '%s\n' \
        'Package: libcamera-dev:arm64 libcamera0.7:arm64 libcamera-ipa:arm64 libpisp1:arm64 libpisp1:amd64 libpisp-common' \
        'Pin: origin "archive.raspberrypi.com"' \
        'Pin-Priority: 1000' \
        '' \
        'Package: *' \
        'Pin: origin "archive.raspberrypi.com"' \
        'Pin-Priority: 100' \
        > /etc/apt/preferences.d/raspberrypi.pref

# libcamera revision installed on the robot. The archive only indexes the newest
# ones, so the .debs are downloaded from the pool and checked against
# docker/libcamera.sha256.
ARG RPT_LIBCAMERA_VERSION=0.7.2+rpt20260817-1
ARG RPT_LIBPISP_VERSION=1.7.0-1

# The apt lists are kept for the pinned install below (same layer series).
RUN apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        ninja-build \
        git \
        curl \
        ca-certificates \
        pkg-config \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        libsqlite3-dev:arm64 \
        libopencv-dev:arm64 \
        libopencv-contrib-dev:arm64 \
        rsync \
        openssh-client

# Headers keep their 2026-08 package date: touch them so ninja recompiles a
# build/arm64 tree built against another libcamera revision.
RUN set -eu; \
    curl -fsSLO "http://archive.raspberrypi.com/debian/pool/main/libc/libcamera/libcamera0.7_${RPT_LIBCAMERA_VERSION}_arm64.deb"; \
    curl -fsSLO "http://archive.raspberrypi.com/debian/pool/main/libc/libcamera/libcamera-dev_${RPT_LIBCAMERA_VERSION}_arm64.deb"; \
    curl -fsSLO "http://archive.raspberrypi.com/debian/pool/main/libc/libcamera/libcamera-ipa_${RPT_LIBCAMERA_VERSION}_arm64.deb"; \
    curl -fsSLO "http://archive.raspberrypi.com/debian/pool/main/libp/libpisp/libpisp1_${RPT_LIBPISP_VERSION}_arm64.deb"; \
    curl -fsSLO "http://archive.raspberrypi.com/debian/pool/main/libp/libpisp/libpisp-common_${RPT_LIBPISP_VERSION}_all.deb"; \
    curl -fsSLo libcamera.sha256 https://raw.githubusercontent.com/robotronik/CDFR2026-Programme-Robot/main/docker/libcamera.sha256; \
    sha256sum -c libcamera.sha256; \
    apt-get install -y --no-install-recommends ./*.deb; \
    rm -rf /var/lib/apt/lists/* ./*.deb libcamera.sha256; \
    find /usr/include/libcamera -name '*.h' -exec touch {} +

# The robot has 0.7.2 with the Span-based generateConfiguration, not the std::span of 0.8.
RUN test "$(readlink -f /usr/lib/aarch64-linux-gnu/libcamera.so.0.7)" = /usr/lib/aarch64-linux-gnu/libcamera.so.0.7.2 \
    && grep -q 'generateConfiguration(Span<const StreamRole>' /usr/include/libcamera/libcamera/camera.h

# External robot repositories: drive/protocol headers used at compile time.
# Baked into the image so the build is self-contained.
ARG DRIVE_CONTROL_REF=main
ARG ACTIONNEUR_REF=master
# BuildKit resolves the branch head on each build, so a new commit invalidates the layer; .git is not kept.
ADD https://github.com/robotronik/CDFR2026-Program-DriveControl.git#${DRIVE_CONTROL_REF} /opt/cdfr/CDFR2026-Program-DriveControl
ADD https://github.com/robotronik/cdfr2024-programme-Actionneur.git#${ACTIONNEUR_REF} /opt/cdfr/cdfr2024-programme-Actionneur

# Debian has no non-root user, so create `ubuntu` (uid/gid 1000) like the old
# Ubuntu base: workspace files stay user-owned, and build.sh's --user and the
# $HOME/.ssh bind mount have a home.
RUN groupadd -g 1000 ubuntu \
    && useradd -m -u 1000 -g 1000 -s /bin/bash ubuntu
ENV HOME=/home/ubuntu

WORKDIR /workspace
