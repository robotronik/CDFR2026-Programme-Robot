# Build image for the aarch64 (Raspberry Pi) target, cross-compiled on amd64 with
# the aarch64-linux-gnu toolchain; target libraries come from arm64 multiarch
# packages. The base is Debian 13 (trixie), matching Raspberry Pi OS Trixie: GCC
# 14 / glibc 2.41, OpenCV 4.10, and the Pi libcamera fork (libcamera.so.0.8).
# OpenCV is installed as runtime libraries plus -dev headers (see Dockerfile.x86_64).

FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# Add the Raspberry Pi archive for the libcamera fork that drives the Pi 5 camera.
# It is marked trusted (not signed-by): its InRelease is SHA1-signed, which
# trixie's `sqv` refuses. (Debian's own trixie suites already cover arm64.)
RUN dpkg --add-architecture arm64 \
    && printf '%s\n' \
        'deb [trusted=yes] http://archive.raspberrypi.com/debian/ trixie main' \
        > /etc/apt/sources.list.d/raspberrypi.list

# Keep the Pi archive at low priority so Debian wins everywhere, and prefer it
# only for the libcamera stack. Pins must name the foreign architecture
# explicitly (pkg:arm64) or they do not match; libpisp1 is Multi-Arch: same and
# also in Debian, so both architectures are pinned to the Pi version so apt can
# pair arm64 libcamera0.8 with a matching libpisp1.
RUN printf '%s\n' \
        'Package: libcamera-dev:arm64 libcamera0.8:arm64 libcamera-ipa:arm64 libpisp1:arm64 libpisp1:amd64 libpisp-common' \
        'Pin: origin "archive.raspberrypi.com"' \
        'Pin-Priority: 1000' \
        '' \
        'Package: *' \
        'Pin: origin "archive.raspberrypi.com"' \
        'Pin-Priority: 100' \
        > /etc/apt/preferences.d/raspberrypi.pref

RUN --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=tmpfs,target=/tmp/opencv-dev \
    apt-get update && apt-get install -y --no-install-recommends \
        cmake \
        ninja-build \
        git \
        ca-certificates \
        pkg-config \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        libsqlite3-dev:arm64 \
        libopencv-core410:arm64 \
        libopencv-imgproc410:arm64 \
        libopencv-imgcodecs410:arm64 \
        libopencv-videoio410:arm64 \
        libopencv-calib3d410:arm64 \
        libopencv-features2d410:arm64 \
        libopencv-flann410:arm64 \
        libopencv-objdetect410:arm64 \
        libcamera-dev:arm64 \
        rsync \
        openssh-client \
    && cd /tmp/opencv-dev \
    && apt-get download \
        libopencv-core-dev:arm64 \
        libopencv-imgproc-dev:arm64 \
        libopencv-imgcodecs-dev:arm64 \
        libopencv-videoio-dev:arm64 \
        libopencv-calib3d-dev:arm64 \
        libopencv-features2d-dev:arm64 \
        libopencv-flann-dev:arm64 \
        libopencv-objdetect-dev:arm64 \
    && for d in libopencv-*-dev_*_arm64.deb; do dpkg-deb --fsys-tarfile "$d" | tar -x -C / --wildcards './usr/include/*' './usr/lib/*/*.so'; done

# External robot repositories: drive/protocol headers used at compile time.
# Baked into the image so the build is self-contained.
ARG DRIVE_CONTROL_REF=main
ARG ACTIONNEUR_REF=master
# BuildKit resolves the branch head on each build, so a new commit invalidates the layer; .git is not kept.
ADD https://github.com/robotronik/CDFR2026-Program-DriveControl.git#${DRIVE_CONTROL_REF} /opt/cdfr/CDFR2026-Program-DriveControl
ADD https://github.com/robotronik/cdfr2024-programme-Actionneur.git#${ACTIONNEUR_REF} /opt/cdfr/cdfr2024-programme-Actionneur

# Debian has no non-root user, so create `ubuntu` (uid/gid 1000) like the old
# Ubuntu base: workspace files stay user-owned, and build.sh's --user and the
# $HOME/.ssh bind mount have a home.
RUN groupadd -g 1000 ubuntu \
    && useradd -m -u 1000 -g 1000 -s /bin/bash ubuntu
ENV HOME=/home/ubuntu

WORKDIR /workspace
