# Build image for the x86_64 target (native compilation inside the container).

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        git \
        ca-certificates \
        sudo \
        libsqlite3-dev \
        libopencv-dev \
        libopencv-contrib-dev \
        clangd-18 \
    && ln -s /usr/lib/llvm-18/bin/clangd /usr/bin/clangd \
    && rm -rf /var/lib/apt/lists/*

# External robot repositories: drive/protocol headers used at compile time.
# Baked into the image so the build is self-contained.
ARG DRIVE_CONTROL_REF=main
ARG ACTIONNEUR_REF=master
# BuildKit resolves the branch head on each build, so a new commit invalidates the layer; .git is not kept.
ADD https://github.com/robotronik/CDFR2026-Program-DriveControl.git#${DRIVE_CONTROL_REF} /opt/cdfr/CDFR2026-Program-DriveControl
ADD https://github.com/robotronik/cdfr2024-programme-Actionneur.git#${ACTIONNEUR_REF} /opt/cdfr/cdfr2024-programme-Actionneur

# Reuse the base image's non-root `ubuntu` user (uid/gid 1000) so workspace files
# stay user-owned (Dev Containers remaps the uid; build.sh passes --user).
ENV HOME=/home/ubuntu

WORKDIR /workspace
