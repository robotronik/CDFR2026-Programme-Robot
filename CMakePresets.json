{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "local",
      "displayName": "Local x86_64",
      "description": "Local build for host architecture with Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "docker-local",
      "displayName": "Docker Local x86_64",
      "description": "Docker build for host architecture with Ninja",
      "inherits": "local",
      "binaryDir": "${sourceDir}/build-docker"
    },
    {
      "name": "arm",
      "displayName": "ARM64 Cross-compilation",
      "description": "Cross-compilation targeting AArch64 Linux with Ninja",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build_arm",
      "toolchainFile": "${sourceDir}/cmake/aarch64_toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "docker-arm",
      "displayName": "Docker ARM64 Cross-compilation",
      "description": "Docker cross-compilation targeting AArch64 Linux with Ninja",
      "inherits": "arm",
      "binaryDir": "${sourceDir}/build_arm-docker"
    }
  ],
  "buildPresets": [
    {
      "name": "local",
      "displayName": "Build Local",
      "configurePreset": "local"
    },
    {
      "name": "docker-local",
      "displayName": "Build Docker Local",
      "configurePreset": "docker-local"
    },
    {
      "name": "arm",
      "displayName": "Build ARM",
      "configurePreset": "arm"
    },
    {
      "name": "docker-arm",
      "displayName": "Build Docker ARM",
      "configurePreset": "docker-arm"
    }
  ],
  "testPresets": [
    {
      "name": "local",
      "displayName": "Test Local",
      "configurePreset": "local",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "docker-local",
      "displayName": "Test Docker Local",
      "configurePreset": "docker-local",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
